<div
  phx-update="ignore"
  data-rendered={@showing_within}
  class="h-full flex-1 grow min-h-0 overflow-y-auto overscroll-contain"
  :hook
  data-editor-bundle={Bonfire.Common.URIs.versioned_static_path("/assets/milkdown_editor.js")}
  data-suggestion={e(@smart_input_opts, :text_suggestion, nil) || e(@smart_input_opts, :text, nil)}
  data-replace-draft-confirm={l("Replace your draft with this reply? The draft will be discarded.")}
  data-disable-mentions={e(@smart_input_opts, :create_object_type, nil) in [:message, "message"] and "true"}
  id="editor_milkdown_container"
  aria-label="Markdown editor"
  role="textbox"
  aria-multiline="true"
>
  <span class="sr-only">
    <label for="editor_hidden_input">{l("Content")}</label>
    {!-- a textarea: an input's value is an attribute, and daisyUI's theme-controller :has() rule restyles the whole page whenever it changes --}
    <textarea
      name={@field_name}
      id="editor_hidden_input"
      hidden
      aria-hidden="true"
      data-persist-draft
      phx-debounce="blur"
    >{"\n"}{e(@smart_input_opts, :text_suggestion, nil) || e(@smart_input_opts, :text, nil)}</textarea>
  </span>
  <div
    id="editor"
    class="w-full flex flex-1 h-full min-h-0 markdown-editor"
    data-placeholder={l("What’s on your mind?")}
  >
  </div>
</div>
